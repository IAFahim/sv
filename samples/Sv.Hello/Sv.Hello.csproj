<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Hello</RootNamespace>
    <SvPackNamespace>Hello.Sv</SvPackNamespace>
    <SvPackOutput>$(MSBuildProjectDirectory)/obj/SvPack/</SvPackOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sv.Host/Sv.Host.csproj" />
    <ProjectReference Include="../../src/Sv.Pack/Sv.Pack.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="../../build/Sv.Pack.targets" />
</Project>
