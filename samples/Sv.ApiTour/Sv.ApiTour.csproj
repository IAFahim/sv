<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>ApiTour</RootNamespace>
    <SvPackFolder>$(MSBuildProjectDirectory)/../Sv.Hello/pack</SvPackFolder>
    <SvPackNamespace>Hello.Sv</SvPackNamespace>
    <SvPackOutput>$(MSBuildProjectDirectory)/obj/SvPack/</SvPackOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sv.Host/Sv.Host.csproj" />
    <ProjectReference Include="../../src/Sv.Pack/Sv.Pack.csproj" ReferenceOutputAssembly="false" />
    <None Include="../Sv.Hello/pack/*.sv.json" Link="pack/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="../../build/Sv.Pack.targets" />
</Project>
