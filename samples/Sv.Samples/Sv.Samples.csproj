<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sv\Sv.csproj" />
    <ProjectReference Include="..\..\src\Sv.Compose\Sv.Compose.csproj" />
    <ProjectReference Include="..\..\src\Sv.Frent\Sv.Frent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tl.Runtime" Version="1.3.0" />
    <PackageReference Include="Tl.Gen.CSharp" Version="1.3.0" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" AdditionalProperties="TargetFramework=netstandard2.0"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tests\Sv.Tests\StrictFloatOracle.cs" Link="StrictFloatOracle.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="jump.tlb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
