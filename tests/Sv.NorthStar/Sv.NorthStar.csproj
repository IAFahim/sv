<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Tl.Runtime" Version="1.3.0" />
    <PackageReference Include="Tl.Gen.CSharp" Version="1.3.0" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" AdditionalProperties="TargetFramework=netstandard2.0" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sv\Sv.csproj" />
    <ProjectReference Include="..\..\src\Sv.Compose\Sv.Compose.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Sv.Tests\StrictFloatOracle.cs" Link="StrictFloatOracle.cs" />
  </ItemGroup>

  <PropertyGroup>
    <KernelsRoot Condition="'$(KernelsRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../ecs-kernels-new'))</KernelsRoot>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(KernelsRoot)/dotnet/Kernels/Kernels.csproj')">
    <DefineConstants>$(DefineConstants);KERNELS_PRESENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(KernelsRoot)/dotnet/Kernels/Kernels.csproj')">
    <ProjectReference Include="$(KernelsRoot)/dotnet/Kernels/Kernels.csproj" />
    <ProjectReference Include="$(KernelsRoot)/generator/Kernels.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include="$(KernelsRoot)/packages/com.game.simulation/Components.cs" Link="Kernels/Components.cs" />
    <Compile Include="$(KernelsRoot)/packages/com.game.simulation/Fall.cs" Link="Kernels/Fall.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="jump.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="jump.tlb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
