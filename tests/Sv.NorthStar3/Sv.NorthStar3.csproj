<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);TLGEN114</NoWarn>
    <TlRoot Condition="'$(TlRoot)' == '' and '$(TL_ROOT)' != ''">$(TL_ROOT)</TlRoot>
    <TlRoot Condition="'$(TlRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../tl'))</TlRoot>
    <TlPresent Condition="Exists('$(TlRoot)/src/Tl.Core/Tl.Core.csproj')">true</TlPresent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="..\..\src\Sv.Core\Sv.Core.csproj" />
    <ProjectReference Include="..\..\src\Sv.Rules\Sv.Rules.csproj" />
    <ProjectReference Include="..\..\src\Sv.Host\Sv.Host.csproj" />
    <ProjectReference Include="..\..\src\Sv.Pack\Sv.Pack.csproj" />
    <ProjectReference Include="..\Sv.Kernels.NorthStar3\Sv.Kernels.NorthStar3.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TlPresent)' == 'true'">
    <ProjectReference Include="$(TlRoot)/src/Tl.Core/Tl.Core.csproj" />
    <ProjectReference Include="$(TlRoot)/tools/Tl.Gen.Tlb/Tl.Gen.Tlb.csproj" />
    <ProjectReference Include="$(TlRoot)/src/Tl.Gen.CSharp/Tl.Gen.CSharp.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" AdditionalProperties="TargetFramework=netstandard2.0" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Glue.g.cs" Link="Glue.g.cs.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TlPresent)' != 'true'">
    <Compile Remove="**/*.cs" />
  </ItemGroup>

  <Import Project="$(TlRoot)/src/Tl.Gen.CSharp/build/Tl.Gen.CSharp.targets" Condition="'$(TlPresent)' == 'true'" />

</Project>
