<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)portable.runsettings</RunSettingsFilePath>
    <DefineConstants>$(DefineConstants);SV_PORTABLE_LEG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sv\Sv.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
    <ProjectReference Include="..\..\src\Sv.Burst\Sv.Burst.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Sv.Tests\*.cs" Exclude="..\Sv.Tests\CodecTests.cs;..\Sv.Tests\ComposeOrderTests.cs;..\Sv.Tests\ComposeRollbackTests.cs;..\Sv.Tests\StateIntegrityTests.cs;..\Sv.Tests\FrentAdapterTests.cs;..\Sv.Tests\GuardAlwaysOnTests.cs;..\Sv.Tests\MaskSpanTests.cs;..\Sv.Tests\PopulationTests.cs;..\Sv.Tests\ReconcileAtomicityTests.cs;..\Sv.Tests\SchemaGeneratorTests.cs;..\Sv.Tests\WindowGuardTests.cs;..\Sv.Tests\BulkTests.cs;..\Sv.Tests\SchemaCodegenTests.cs;..\Sv.Tests\SimdTests.cs;..\Sv.Tests\NoAllocationTests.cs;..\Sv.Tests\StructMakerTests.cs;..\Sv.Tests\CrossHostDigestTests.cs;..\Sv.Tests\EventsTests.cs;..\Sv.Tests\IsaLegTests.cs;..\Sv.Tests\GuardPageFuzzTests.cs" LinkBase="Shared" />
    <None Include="..\Sv.Tests\mask-fixtures.json" Link="mask-fixtures.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
